# خيال — environment (all optional; the archive runs with zero configuration)

# Set to "1" to produce a fully static export (GitHub Pages, any file host).
# STATIC_EXPORT=1

# Base path for hosts that serve the site under a sub-directory
# (GitHub Pages project sites: /cleofinal3).
# NEXT_PUBLIC_BASE_PATH=/cleofinal3

# Lift the production frame-ancestors refusal — preview panels only, never
# a real deployment.
# ALLOW_FRAMING=true

# Extra dev origins accepted by the dev server (comma-separated).
# NEXT_PUBLIC_DEV_ORIGINS=
