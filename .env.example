# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 32+ random bytes. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true if behind a reverse proxy/CDN (so x-forwarded-for is trusted).
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# Comma-separated list of enabled payment methods.
# Valid options: cod, bank_transfer, gift_card. `card` is not implemented yet.
# PAYMENT_METHODS_ENABLED=cod,bank_transfer,gift_card

# Seed script passwords (development only).
# SEED_ADMIN_PASSWORD=
# SEED_SUPPORT_PASSWORD=
# SEED_CLIENT_PASSWORD=

# Set to 1 to allow seed against NODE_ENV=production (wipes all tables).
# ALLOW_DESTRUCTIVE_SEED=

# ── Transactional e-mail ────────────────────────────────────────────────
# Without RESEND_API_KEY the mailer writes every message to MAIL_SINK_DIR
# instead of sending it — development and a first deploy work with no setup.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="Cléopâtre — Espace Santé Beauté <bonjour@cleopatre.tn>"
# MAIL_REPLY_TO=bonjour@cleopatre.tn
# MAIL_SINK_DIR=.mail
# MAIL_SOCIAL="Instagram|https://instagram.com/cleopatre.tn,Facebook|https://facebook.com/cleopatre.tn"

# Extra hostnames allowed to reach the dev server (comma-separated).
# NEXT_PUBLIC_DEV_ORIGINS=my-preview.example.com
